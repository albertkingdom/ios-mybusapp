default_platform(:ios)

platform :ios do
  def resolved_team_id
    env_team = ENV["FASTLANE_TEAM_ID"].to_s.strip
    return env_team unless env_team.empty?

    appfile_team = CredentialsManager::AppfileConfig.try_fetch_value(:team_id).to_s.strip
    UI.user_error!("Missing team_id. Set it in fastlane/Appfile or FASTLANE_TEAM_ID.") if appfile_team.empty?
    appfile_team
  end

  def fetch_app_store_api_key
    key_id = ENV["ASC_KEY_ID"].to_s
    issuer_id = ENV["ASC_ISSUER_ID"].to_s
    key_path = ENV["ASC_KEY_PATH"].to_s
    key_content = ENV["ASC_KEY_CONTENT"].to_s

    UI.user_error!("Missing ASC_KEY_ID") if key_id.empty?
    UI.user_error!("Missing ASC_ISSUER_ID") if issuer_id.empty?

    api_key_options =
      if !key_path.empty?
        { key_id: key_id, issuer_id: issuer_id, key_filepath: key_path }
      else
        UI.user_error!("Missing ASC_KEY_CONTENT (or set ASC_KEY_PATH)") if key_content.empty?
        is_base64 = !key_content.include?("BEGIN PRIVATE KEY")
        { key_id: key_id, issuer_id: issuer_id, key_content: key_content, is_key_content_base64: is_base64 }
      end

    app_store_connect_api_key(**api_key_options)
  end

  def app_store_build_options(clean:)
    team_id = resolved_team_id

    {
      project: "MyBusMapSwiftUI.xcodeproj",
      scheme: "MyBusMapSwiftUI",
      configuration: "Release",
      export_method: "app-store",
      skip_profile_detection: true,
      xcargs: "DEVELOPMENT_TEAM=#{team_id}",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          "com.a2006mike.MyBusMapSwiftUI" => "match AppStore com.a2006mike.MyBusMapSwiftUI"
        }
      },
      clean: clean,
      output_directory: "fastlane/build"
    }
  end

  def beta_changelog
    path = "beta_changelog.txt"
    return nil unless File.exist?(path)

    content = File.read(path).strip
    content.empty? ? nil : content
  end

  def release_changelog
    path = "release_change_log.txt"
    return nil unless File.exist?(path)

    content = File.read(path).strip
    content.empty? ? nil : content
  end

  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Run unit/UI tests"
  lane :test do
    scan(
      project: "MyBusMapSwiftUI.xcodeproj",
      scheme: "MyBusMapSwiftUI",
      testplan: "MyBusMapSwiftUI",
      devices: (
        ENV["SCAN_DEVICES"]&.split(",")&.map(&:strip) || ["iPhone 16e", "iPhone 17", "iPhone 17 Pro", "iPhone 16 Pro", "iPhone 15", "iPhone 14"]
      ),
      output_style: "raw",
      xcargs: "-disable-concurrent-testing",
      clean: true
    )
  end

  desc "Build app-store IPA (no upload)"
  lane :build do
    match(type: "appstore", readonly: !!ENV["CI"])

    build_app(**app_store_build_options(clean: true))
  end

  desc "Build + upload to TestFlight (requires signing + App Store Connect API key)"
  lane :beta do
    api_key = fetch_app_store_api_key

    match(type: "appstore", readonly: !!ENV["CI"], api_key: api_key)
    
    build_app(**app_store_build_options(clean: true))
    
    pilot_options = { api_key: api_key, skip_waiting_for_build_processing: true }
    changelog = beta_changelog
    pilot_options[:changelog] = changelog if changelog

    pilot(**pilot_options)
  end

  desc "Smoke: build + upload to TestFlight (no tests, less clean)"
  lane :beta_smoke do
    api_key = fetch_app_store_api_key

    match(type: "appstore", readonly: !!ENV["CI"], api_key: api_key)
    
    build_app(**app_store_build_options(clean: false))

    pilot_options = { api_key: api_key, skip_waiting_for_build_processing: true }
    changelog = beta_changelog
    pilot_options[:changelog] = changelog if changelog

    pilot(**pilot_options)
  end

  desc "Build + upload + submit for App Store review"
  lane :submit_app_store do
    api_key = fetch_app_store_api_key

    match(type: "appstore", readonly: !!ENV["CI"], api_key: api_key)
    
    build_app(**app_store_build_options(clean: true))

    deliver_options = {
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: true
    }
    changelog = release_changelog
    deliver_options[:release_notes] = changelog if changelog

    deliver(**deliver_options)
  end

  desc "Sync code signing assets via match (type: development|adhoc|appstore)"
  lane :sync_signing do |options|
    match(
      type: (options[:type] || "appstore"),
      readonly: (options[:readonly] == true || options[:readonly].to_s == "true")
    )
  end

  desc "CI lane (tests only)"
  lane :ci do
    test
  end
end
