default_platform(:ios)

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Run unit/UI tests"
  lane :test do
    scan(
      project: "MyBusMapSwiftUI.xcodeproj",
      scheme: "MyBusMapSwiftUI",
      testplan: "MyBusMapSwiftUI",
      devices: (
        ENV["SCAN_DEVICES"]&.split(",")&.map(&:strip) || ["iPhone 16e", "iPhone 17", "iPhone 17 Pro", "iPhone 16 Pro", "iPhone 15", "iPhone 14"]
      ),
      output_style: "raw",
      xcargs: "-disable-concurrent-testing",
      clean: true
    )
  end

  desc "Build app-store IPA (no upload)"
  lane :build do
    match(type: "appstore", readonly: !!ENV["CI"])
    gym(
      project: "MyBusMapSwiftUI.xcodeproj",
      scheme: "MyBusMapSwiftUI",
      configuration: "Release",
      codesigning_identity: "Apple Distribution",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.a2006mike.MyBusMapSwiftUI" => "match AppStore com.a2006mike.MyBusMapSwiftUI"
        }
      },
      xcargs: "CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER='match AppStore com.a2006mike.MyBusMapSwiftUI' DEVELOPMENT_TEAM=UZ2Z639589",
      clean: true,
      output_directory: "fastlane/build"
    )
  end

  desc "Build + upload to TestFlight (requires signing + App Store Connect API key)"
  lane :beta do
    key_id = ENV["ASC_KEY_ID"].to_s
    issuer_id = ENV["ASC_ISSUER_ID"].to_s
    key_path = ENV["ASC_KEY_PATH"].to_s
    key_content = ENV["ASC_KEY_CONTENT"].to_s

    UI.user_error!("Missing ASC_KEY_ID") if key_id.empty?
    UI.user_error!("Missing ASC_ISSUER_ID") if issuer_id.empty?

    api_key_options =
      if !key_path.empty?
        { key_id: key_id, issuer_id: issuer_id, key_filepath: key_path }
      else
        UI.user_error!("Missing ASC_KEY_CONTENT (or set ASC_KEY_PATH)") if key_content.empty?
        is_base64 = !key_content.include?("BEGIN PRIVATE KEY")
        { key_id: key_id, issuer_id: issuer_id, key_content: key_content, is_key_content_base64: is_base64 }
      end

    api_key = app_store_connect_api_key(**api_key_options)

    match(type: "appstore", readonly: !!ENV["CI"], api_key: api_key)
    
    gym(
      project: "MyBusMapSwiftUI.xcodeproj",
      scheme: "MyBusMapSwiftUI",
      configuration: "Release",
      codesigning_identity: "Apple Distribution",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.a2006mike.MyBusMapSwiftUI" => "match AppStore com.a2006mike.MyBusMapSwiftUI"
        }
      },
      xcargs: "CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER='match AppStore com.a2006mike.MyBusMapSwiftUI' DEVELOPMENT_TEAM=UZ2Z639589",
      clean: true,
      output_directory: "fastlane/build"
    )
    
    pilot(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Sync code signing assets via match (type: development|adhoc|appstore)"
  lane :sync_signing do |options|
    match(
      type: (options[:type] || "appstore"),
      readonly: (options[:readonly] == true || options[:readonly].to_s == "true")
    )
  end

  desc "CI lane (tests only)"
  lane :ci do
    test
  end
end
