## Copy to `fastlane/.env` for local usage (DO NOT COMMIT secrets)
#
# MATCH_GIT_URL=git@github.com:YOUR_ORG/your-app-match.git
# MATCH_GIT_BRANCH=main
#
# Used to access Apple Developer Portal when creating/renewing signing assets:
# FASTLANE_USER=you@example.com
#
# Used to encrypt/decrypt the match repo (store in Keychain locally; CI secret in your pipeline):
# MATCH_PASSWORD=use-a-long-random-password
#
# App Store Connect API key (for upload lanes like `beta`)
# ASC_KEY_ID=ABCDE12345
# ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# ASC_KEY_CONTENT=BASE64_OF_P8_CONTENT
